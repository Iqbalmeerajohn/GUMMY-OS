# GUMMY backend — environment template.
# Copy to `.env` (gitignored) and fill in real values:  cp .env.example .env
#
# This file documents the BACKEND-specific variables. The full shared template
# (database, Supabase, LLM, embeddings, …) lives in the repo-root `../.env.example`.
# Settings are loaded via pydantic-settings; unknown keys are ignored.

# ── Observability (Sentry) ────────────────────────────────────────────────────
# Error monitoring + performance tracing for the FastAPI app and background
# workers. Monitoring is fully DISABLED (a no-op) when SENTRY_DSN is empty, so
# local and CI runs never emit events. The DSN is not a strict secret, but keep
# it per-environment. On Railway, set these in the service's Variables.
#   DSN: Sentry → Project → Settings → Client Keys (DSN).
SENTRY_DSN=
# Deploy environment tag shown in Sentry. Defaults to APP_ENV when unset.
SENTRY_ENVIRONMENT=production
# Performance trace sample rate, 0–1 (0.1 = 10% of transactions traced).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Profiling sample rate, 0–1 (relative to traced transactions). 0 disables.
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ── Observability (Langfuse — LLM/agent tracing) ──────────────────────────────
# Traces every LLM call with token usage, latency, cost, plus memory-retrieval
# and agent-orchestration metadata. Tracing is fully DISABLED (a no-op) unless
# BOTH keys below are set, so local and CI runs never emit events and never need
# the SDK reachable. The SECRET key is a real secret — never commit it; set it
# per-environment (on Railway, the service's Variables).
#   Keys: Langfuse → Project → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse ingestion host. Cloud default below; use https://us.cloud.langfuse.com
# for US region, or your self-hosted URL.
LANGFUSE_HOST=https://cloud.langfuse.com
# Environment tag shown in Langfuse. Defaults to APP_ENV when unset.
LANGFUSE_ENVIRONMENT=production
# Trace sample rate, 0–1 (1.0 = trace every call). Lower it under high volume.
LANGFUSE_SAMPLE_RATE=1.0
