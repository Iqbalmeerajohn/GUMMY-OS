# GUMMY backend — environment template.
# Copy to `.env` (gitignored) and fill in real values:  cp .env.example .env
#
# This file documents the BACKEND-specific variables. The full shared template
# (database, auth, LLM, embeddings, …) lives in the repo-root `../.env.example`.
# Settings are loaded via pydantic-settings; unknown keys are ignored.
#
# GUMMY sends nothing anywhere by default. Errors and product events are written
# to the local log only — there is no error-tracking or analytics SDK to key.

# ── Auth (GUMMY is its own identity provider) ─────────────────────────────────
# Signing secret for the access tokens this server mints. Generate one:
#   openssl rand -hex 32
# Leaving it at the default is a startup failure in production (assert_auth_safe).
GUMMY_JWT_SECRET=
# Single-user machine: sign every request in as the local owner, no login wall.
# MUST be false in production — it disables authentication by design.
#
# It also disables SIGN-OUT. If a request with no credential resolves to the
# owner, discarding the token cannot log anyone out: the client asks who it is
# and is told it is still the owner. Leave this false to use real accounts.
GUMMY_OWNER_MODE=false
GUMMY_OWNER_EMAIL=owner@gummy.local

# ── Google sign-in (optional) ─────────────────────────────────────────────────
# Google Cloud console → Credentials → OAuth client ID → Web application, with
# authorized redirect URI:
#   http://localhost:8000/api/v1/auth/google/callback
# Left blank, /api/v1/auth/config reports google_enabled=false and the login
# screen never shows a button the server cannot honour.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Password reset -----------------------------------------------------------
# Where reset links point. Must be the URL the browser actually uses.
FRONTEND_URL=http://localhost:3000
# How long a reset link stays valid, in minutes. Short by design: it is a
# bearer credential for the account.
PASSWORD_RESET_TTL_MINUTES=45

# How auth email is delivered: console | smtp
#
# "console" is the local-first default -- the message, reset link and all, is
# written to the backend log (tagged [GUMMY AUTH]). The whole recovery flow is
# then testable with no provider, no credentials, and no outbound network, and
# nothing ever claims an email was sent when none was.
#
# Set "smtp" for real delivery. SMTP_HOST is then required; the app refuses to
# start with an unknown mode rather than silently falling back to console.
AUTH_EMAIL_MODE=console

# Only read when AUTH_EMAIL_MODE=smtp. Leave empty otherwise.
# NEVER commit a real password here -- .env is gitignored, this file is not.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ── LLM / embeddings (local by default) ───────────────────────────────────────
# ollama (free, offline) | claude | openai | fake (tests). Ollama needs
# `ollama serve` plus `ollama pull qwen2.5:3b` and `ollama pull nomic-embed-text`.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDINGS_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
# Optional paid providers — only read when LLM_PROVIDER/EMBEDDINGS_PROVIDER
# select them. Ollama stays the default so running GUMMY costs nothing.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Live web search (Tavily) ──────────────────────────────────────────────────
# The Research and Career agents refuse to state current facts without evidence.
# With no key configured they say so plainly instead of guessing, which is the
# safe default — set both of these to let them actually look things up.
#
# Key: https://app.tavily.com  (free tier available). Backend-only: it is never
# sent to the frontend and never appears in a log, trace or API response.
# NEVER put a real key in this file — .env is gitignored, this template is not.
TAVILY_API_KEY=
AGENTS_WEB_SEARCH_ENABLED=false

# ── Observability (Langfuse — LLM/agent tracing, optional) ────────────────────
# Traces every LLM call with token usage, latency, cost, plus memory-retrieval
# and agent-orchestration metadata. Fully DISABLED (a no-op) unless BOTH keys
# below are set, so a default install emits nothing. Point LANGFUSE_HOST at a
# self-hosted instance to keep traces on this machine.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Environment tag shown in Langfuse. Defaults to APP_ENV when unset.
LANGFUSE_ENVIRONMENT=development
# Trace sample rate, 0–1 (1.0 = trace every call). Lower it under high volume.
LANGFUSE_SAMPLE_RATE=1.0
