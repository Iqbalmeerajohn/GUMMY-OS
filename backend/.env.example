# GUMMY backend — environment template.
# Copy to `.env` (gitignored) and fill in real values:  cp .env.example .env
#
# This file documents the BACKEND-specific variables. The full shared template
# (database, auth, LLM, embeddings, …) lives in the repo-root `../.env.example`.
# Settings are loaded via pydantic-settings; unknown keys are ignored.
#
# GUMMY sends nothing anywhere by default. Errors and product events are written
# to the local log only — there is no error-tracking or analytics SDK to key.

# ── Auth (GUMMY is its own identity provider) ─────────────────────────────────
# Signing secret for the access tokens this server mints. Generate one:
#   openssl rand -hex 32
# Leaving it at the default is a startup failure in production (assert_auth_safe).
GUMMY_JWT_SECRET=
# Single-user machine: sign every request in as the local owner, no login wall.
# MUST be false in production — it disables authentication by design.
GUMMY_OWNER_MODE=false
GUMMY_OWNER_EMAIL=owner@gummy.local

# ── Google sign-in (optional) ─────────────────────────────────────────────────
# Google Cloud console → Credentials → OAuth client ID → Web application, with
# authorized redirect URI:
#   http://localhost:8000/api/v1/auth/google/callback
# Left blank, /api/v1/auth/config reports google_enabled=false and the login
# screen never shows a button the server cannot honour.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LLM / embeddings (local by default) ───────────────────────────────────────
# ollama (free, offline) | claude | openai | fake (tests). Ollama needs
# `ollama serve` plus `ollama pull qwen2.5:3b` and `ollama pull nomic-embed-text`.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDINGS_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
# Optional paid providers — only read when LLM_PROVIDER/EMBEDDINGS_PROVIDER
# select them. Ollama stays the default so running GUMMY costs nothing.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Observability (Langfuse — LLM/agent tracing, optional) ────────────────────
# Traces every LLM call with token usage, latency, cost, plus memory-retrieval
# and agent-orchestration metadata. Fully DISABLED (a no-op) unless BOTH keys
# below are set, so a default install emits nothing. Point LANGFUSE_HOST at a
# self-hosted instance to keep traces on this machine.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Environment tag shown in Langfuse. Defaults to APP_ENV when unset.
LANGFUSE_ENVIRONMENT=development
# Trace sample rate, 0–1 (1.0 = trace every call). Lower it under high volume.
LANGFUSE_SAMPLE_RATE=1.0
