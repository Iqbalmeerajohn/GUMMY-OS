# ──────────────────────────────────────────────────────────────────────────────
# GUMMY OS — Environment Variable Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (never commit `.env`) and fill in real values.
#   cp .env.example .env
#
# Variables are grouped by concern and mirror the locked stack in
# architecture/tech-stack.md. Placeholders are intentionally fake — replace them.
# Secrets (service-role keys, API keys) belong in the BACKEND only; never expose
# them to the browser. Public, browser-safe values are prefixed NEXT_PUBLIC_.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
APP_NAME="GUMMY OS"
LOG_LEVEL=info                            # debug | info | warning | error

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API (the frontend URL in each env).
BACKEND_CORS_ORIGINS=http://localhost:3000
# Secret used to sign/verify internal tokens & sessions. Generate a long random
# value, e.g.  openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Base URL the browser uses to reach the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL via Supabase) ────────────────────────────────────────
# Pooled connection (PgBouncer) for the app runtime — use this in FastAPI.
DATABASE_URL=postgresql://postgres:password@localhost:5432/gummy_os
# Direct (non-pooled) connection for migrations / schema tools only.
DIRECT_DATABASE_URL=postgresql://postgres:password@localhost:5432/gummy_os

# ── Supabase (DB / Auth / Storage) ────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# anon key is browser-safe (RLS enforces access); service-role key is SECRET.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key   # BACKEND ONLY — never ship to client
SUPABASE_JWT_SECRET=your-supabase-jwt-secret             # to verify Auth JWTs at the API

# ── File Storage (Supabase Storage, S3-compatible) ────────────────────────────
STORAGE_BUCKET=gummy-documents

# ── AI Models (Claude / Anthropic) ────────────────────────────────────────────
# Primary LLM provider. Confirm current model IDs & pricing from Anthropic docs
# before locking spend (see tech-stack.md §7). BACKEND ONLY.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Tiered model strategy — small/fast for routing & summarization, frontier for reasoning.
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_SMART=claude-sonnet-4-6
CLAUDE_MODEL_FRONTIER=claude-opus-4-8
# Embeddings (semantic memory search). Default: a local Hugging Face model — no
# API key, no per-call cost. Set EMBEDDINGS_PROVIDER=fake for deterministic
# dev/test vectors. EMBEDDING_DIMENSION must match the model and the DB vector
# column (changing it requires a migration).
EMBEDDINGS_PROVIDER=huggingface
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Optional swappable secondary providers (via the LLM gateway). Leave blank if unused.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Web Search (Research Agent — Phase 4+) ────────────────────────────────────
TAVILY_API_KEY=                           # optional until Phase 4

# ── Observability ─────────────────────────────────────────────────────────────
# Error tracking (Sentry). DSNs are not secret but keep them per-environment.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# LLM / agent tracing (Langfuse).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Product Analytics & Feature Flags (PostHog) ───────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
