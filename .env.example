# ──────────────────────────────────────────────────────────────────────────────
# GUMMY OS — Environment Variable Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (never commit `.env`) and fill in real values.
#   cp .env.example .env
#
# Variables are grouped by concern and mirror the locked stack in
# architecture/tech-stack.md. Placeholders are intentionally fake — replace them.
# Secrets (service-role keys, API keys) belong in the BACKEND only; never expose
# them to the browser. Public, browser-safe values are prefixed NEXT_PUBLIC_.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
APP_NAME="GUMMY OS"
LOG_LEVEL=info                            # debug | info | warning | error

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API (the frontend URL in each env).
# NOTE: the backend sends allow_credentials=True, so wildcard "*" is INVALID here —
# list exact origins. In production (Railway) set this to the deployed frontend
# origin(s), e.g.:
#   BACKEND_CORS_ORIGINS=https://gummy-os.vercel.app
# Add preview deploys if needed (comma-separated, no spaces):
#   BACKEND_CORS_ORIGINS=https://gummy-os.vercel.app,https://gummy-os-git-main-<team>.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000
# Secret used to sign/verify internal tokens & sessions. Generate a long random
# value, e.g.  openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# Base URL the browser uses to reach the FastAPI backend.
# IMPORTANT: NEXT_PUBLIC_* vars are INLINED AT BUILD TIME by Next.js. On Vercel they
# must be set in the Project's Environment Variables for the *Production* environment
# BEFORE the build, and the project must be REDEPLOYED after any change. If unset,
# the app falls back to http://localhost:8000 (the cause of localhost requests in prod).
# Production value (Railway backend, no trailing slash):
#   NEXT_PUBLIC_API_BASE_URL=https://gummy-os-production.up.railway.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Production value (the deployed Vercel URL):
#   NEXT_PUBLIC_APP_URL=https://gummy-os.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (PostgreSQL via Supabase) ────────────────────────────────────────
# Pooled connection (PgBouncer) for the app runtime — use this in FastAPI.
DATABASE_URL=postgresql://postgres:password@localhost:5432/gummy_os
# Direct (non-pooled) connection for migrations / schema tools only.
DIRECT_DATABASE_URL=postgresql://postgres:password@localhost:5432/gummy_os

# ── Supabase (DB / Auth / Storage) ────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# anon key is browser-safe (RLS enforces access); service-role key is SECRET.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key   # BACKEND ONLY — never ship to client
SUPABASE_JWT_SECRET=your-supabase-jwt-secret             # legacy HS256 secret (Project Settings → API → JWT Keys)

# ── Authentication (Phase 1.5) ────────────────────────────────────────────────
# Access tokens are verified locally. The scheme is chosen by the token's `alg`:
#   • ES256 / RS256 → public key from Supabase JWKS (derived from SUPABASE_URL:
#     <SUPABASE_URL>/auth/v1/.well-known/jwks.json). This is what Supabase issues
#     after the "JWT Signing Keys" migration (current key ECC P-256 = ES256).
#   • HS256        → the shared SUPABASE_JWT_SECRET above (legacy signing key).
AUTH_ENABLED=true
# Dev/legacy escape hatch: accept the `user_id` query param / a fixed dev user
# when no bearer token is present. MUST be false in production (startup guard).
AUTH_DEV_BYPASS=false
AUTH_DEV_USER_ID=
SUPABASE_JWT_AUD=authenticated
# Comma-separated allowlist. Keep both during/after the signing-keys migration.
SUPABASE_JWT_ALGORITHMS=ES256,HS256

# ── File Storage (Supabase Storage, S3-compatible) ────────────────────────────
STORAGE_BUCKET=gummy-documents

# ── AI Models (Claude / Anthropic) ────────────────────────────────────────────
# Primary LLM provider. Confirm current model IDs & pricing from Anthropic docs
# before locking spend (see tech-stack.md §7). BACKEND ONLY.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# LLM gateway provider: claude (real) | ollama (local) | fake (dev/tests).
LLM_PROVIDER=claude
# Chat-facing default model. Tiered ids below support the cost-tiering strategy.
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_SMART=claude-sonnet-4-6
CLAUDE_MODEL_FRONTIER=claude-opus-4-8
CLAUDE_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Ollama local inference (used only when LLM_PROVIDER=ollama). No API key, runs
# offline. Start the server (`ollama serve`) and pull the model first
# (`ollama pull qwen2.5:3b`). A small, fast instruction model is the default;
# qwen3:8b also works but is slower (reasoning traces). gemma3:4b is an alt.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Memory context packed into each chat prompt.
CONTEXT_TOKEN_BUDGET=2000
CONTEXT_MAX_MEMORIES=20
# Embeddings (semantic memory search).
#   openai (DEFAULT) — hosted API; lean deploy, no torch/CUDA. Requires
#     OPENAI_API_KEY (below). Uses text-embedding-3-small at 384 dims to match
#     the DB vector column.
#   hf / huggingface — local sentence-transformers model (no API key, no
#     per-call cost) but HEAVY: pulls torch. Requires the optional install
#     `pip install "sentence-transformers>=3.0"`.
#   fake — deterministic vectors for dev/tests.
# EMBEDDING_DIMENSION must match the model output and the DB vector column
# (changing it requires a migration).
EMBEDDINGS_PROVIDER=openai
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Memory extraction consent (memory-system §2). Gates the automatic
# conversation→memory extraction consumer:
#   autonomous = auto-save durable facts (used by the cross-conversation memory)
#   assisted   = persist nothing automatically (proposal surface is future work)
#   explicit   = disable automatic extraction entirely
MEMORY_CONSENT_MODE=autonomous

# OpenAI API key. REQUIRED when EMBEDDINGS_PROVIDER=openai (the default) — used
# for embeddings; also usable as a secondary LLM provider. Set this in Railway.
OPENAI_API_KEY=
# Optional swappable secondary provider (via the LLM gateway). Leave blank if unused.
GOOGLE_API_KEY=

# ── Web Search (Research Agent — Phase 4+) ────────────────────────────────────
TAVILY_API_KEY=                           # optional until Phase 4

# ── Observability ─────────────────────────────────────────────────────────────
# Error tracking (Sentry). DSNs are not secret but keep them per-environment.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# LLM / agent tracing (Langfuse). Backend-only; disabled unless BOTH keys are set.
# The SECRET key is a real secret — keep it out of the repo and the browser.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=production       # defaults to APP_ENV when unset
LANGFUSE_SAMPLE_RATE=1.0              # 0–1; lower under high request volume

# ── Product Analytics & Feature Flags (PostHog) ───────────────────────────────
# Browser-safe: the project key is a write-only ingestion key, not a secret.
# Set these in Vercel (Production + Preview). Empty key ⇒ analytics disabled.
#   US cloud (default): host https://us.i.posthog.com  · ui https://us.posthog.com
#   EU cloud:           host https://eu.i.posthog.com  · ui https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
