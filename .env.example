# ──────────────────────────────────────────────────────────────────────────────
# GUMMY OS — Environment Variable Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (never commit `.env`) and fill in real values:
#   cp .env.example .env
#
# GUMMY runs entirely on one machine: local Postgres, local models, local auth.
# Every hosted service below is OPTIONAL and off unless you key it. Secrets
# belong to the BACKEND only; anything prefixed NEXT_PUBLIC_ ships to the
# browser, so never put a secret there.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
APP_NAME="GUMMY OS"
LOG_LEVEL=info                            # debug | info | warning | error

# ── Backend (FastAPI) ─────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API. The backend sends
# allow_credentials=True, so wildcard "*" is INVALID here — list exact origins.
BACKEND_CORS_ORIGINS=http://localhost:3000
# Fallback signing secret (used when GUMMY_JWT_SECRET is unset). Generate one:
#   openssl rand -hex 32
SECRET_KEY=replace-with-openssl-rand-hex-32

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# NEXT_PUBLIC_* vars are INLINED AT BUILD TIME; change one and rebuild.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (local PostgreSQL 16 + pgvector) ─────────────────────────────────
# `docker compose up -d db` starts exactly this container (see docker-compose.yml
# and ops/db/init). Two roles on purpose: the app connects as `gummy_app`, which
# is NOBYPASSRLS — so a bug in the app cannot read across tenants — while
# migrations run as the owner.
DATABASE_URL=postgresql://gummy_app:gummy_local_dev@localhost:5432/gummy
# Owner connection for migrations / schema tools only.
DIRECT_DATABASE_URL=postgresql://gummy:gummy_local_dev@localhost:5432/gummy

# ── Authentication (GUMMY is its own identity provider) ───────────────────────
# Access tokens are HS256 JWTs minted and verified by this server — one issuer,
# one algorithm, no external service and no network on the request path.
AUTH_ENABLED=true
# Dev/legacy escape hatch: accept the `user_id` query param when no bearer token
# is present. MUST be false in production (startup guard).
AUTH_DEV_BYPASS=false
AUTH_DEV_USER_ID=
# Token signing secret. Falls back to SECRET_KEY when unset; a default/empty
# value in production is a startup failure, not a warning.
GUMMY_JWT_SECRET=
GUMMY_ACCESS_TOKEN_TTL_MINUTES=60
GUMMY_REFRESH_TOKEN_TTL_DAYS=30
# Owner mode: a single-user machine signs in as the owner with no login wall.
# MUST be false in production — it authenticates every request.
GUMMY_OWNER_MODE=false
GUMMY_OWNER_EMAIL=owner@gummy.local

# ── Google sign-in (optional) ─────────────────────────────────────────────────
# Google Cloud console → Credentials → OAuth client ID → Web application.
# Authorized redirect URI must be exactly:
#   http://localhost:8000/api/v1/auth/google/callback
# Blank ⇒ /api/v1/auth/config reports google_enabled=false and the login screen
# shows no Google button. BACKEND ONLY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# ── Files System (M6) ─────────────────────────────────────────────────────────
# Backend storage seam for uploaded file bytes. "local" writes to the filesystem
# (r2/s3 plug in here later without touching the service or API layers).
FILES_STORAGE_PROVIDER=local
FILES_STORAGE_DIR=var/files

# ── AI models (local by default) ──────────────────────────────────────────────
# LLM gateway: ollama (local, free, offline — default) | claude | openai | fake.
# Ollama needs `ollama serve` and `ollama pull qwen2.5:3b`.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# How long Ollama keeps the model resident. A cold load costs seconds on the
# first message, which is exactly the latency the product is fighting.
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Optional paid providers — read only when selected above. Keys stay valid and
# switchable; Ollama is the default so running GUMMY costs nothing.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_SMART=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Memory context packed into each chat prompt.
CONTEXT_TOKEN_BUDGET=2000
CONTEXT_MAX_MEMORIES=20

# ── Embeddings (semantic memory search) ───────────────────────────────────────
#   ollama (DEFAULT) — local nomic-embed-text, 768-d, free, and no text ever
#     leaves the machine. `ollama pull nomic-embed-text` first.
#   openai — hosted API (requires OPENAI_API_KEY), 384-d text-embedding-3-small.
#   hf — local sentence-transformers; heavy (pulls torch), optional extra.
#   fake — deterministic vectors for dev/tests.
# EMBEDDING_DIMENSION must match the model output AND the DB vector column;
# changing it requires a migration.
EMBEDDINGS_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Memory extraction consent (memory-system §2). Gates automatic
# conversation→memory extraction:
#   autonomous = auto-save durable facts (what makes cross-conversation memory work)
#   assisted   = persist nothing automatically (proposal surface is future work)
#   explicit   = disable automatic extraction entirely
MEMORY_CONSENT_MODE=autonomous

# ── Web Search (M8.5; Research / Career / Learning agents) ────────────────────
# Live web search fused into the knowledge engine as a SUPPLEMENTAL source (it
# never overrides the user's own memories/goals/files). Off unless BOTH the flag
# is true AND BRAVE_API_KEY is set; otherwise the offline provider stays active
# and search-worthy queries answer with no Search section. BACKEND ONLY.
AGENTS_WEB_SEARCH_ENABLED=false
BRAVE_API_KEY=
TAVILY_API_KEY=                           # reserved (fallback provider, not used yet)

# ── Observability ─────────────────────────────────────────────────────────────
# Errors and product events are logged locally; there is no error-tracking or
# analytics SDK in the stack. LLM/agent tracing (Langfuse) is the one optional
# integration: disabled unless BOTH keys are set, and LANGFUSE_HOST can point at
# a self-hosted instance so traces never leave the machine. The SECRET key is a
# real secret — backend only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development      # defaults to APP_ENV when unset
LANGFUSE_SAMPLE_RATE=1.0              # 0–1; lower under high request volume
